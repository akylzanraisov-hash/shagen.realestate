# Supabase Edge Function secrets:  supabase secrets set --env-file supabase/.env
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

ELEVENLABS_API_KEY=
# Voice for Zumi's replies (ElevenLabs Voice Library → copy voice id)
ELEVENLABS_VOICE_ID=
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# WhatsApp Business Cloud API (Meta → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Approved message templates with one body variable {{1}}
WA_TEMPLATE_SELF=zumi_note
WA_TEMPLATE_CLIENT=zumi_message
WA_TEMPLATE_LANG=ru

# «Линия Zumi» (Twilio Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_COUNTRY=US
CALL_RECORDING_NOTICE=Разговор записывается для качества обслуживания.
DEFAULT_TZ=Asia/Almaty
DEFAULT_TZ_OFFSET_MIN=300

DAILY_LIMIT=600
