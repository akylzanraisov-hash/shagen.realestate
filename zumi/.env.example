# Copy to .env.local and fill in. Only PUBLIC keys go here — secrets live in Supabase (supabase/.env.example).

# Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project → API keys) — subscriptions via App Store / Google Play
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Short links for Studio pages (host share-viewer/index.html there)
EXPO_PUBLIC_SHARE_BASE_URL=https://zumi.app/p

# «Привет, Зуми» wake word (Picovoice Console → AccessKey + trained .ppn files, Russian model .pv)
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=
EXPO_PUBLIC_WAKEWORD_IOS_URL=
EXPO_PUBLIC_WAKEWORD_ANDROID_URL=
EXPO_PUBLIC_WAKEWORD_MODEL_URL=
