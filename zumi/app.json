{
  "expo": {
    "name": "Zumi",
    "slug": "zumi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zumi",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1214",
    "ios": {
      "bundleIdentifier": "app.zumi.assistant",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "instagram",
          "whatsapp",
          "tg",
          "youtube",
          "snssdk1233",
          "dgis",
          "yandexnavi",
          "yandexmaps",
          "krisha",
          "kaspi",
          "calshow",
          "mobilenotes",
          "message"
        ],
        "NSSpeechRecognitionUsageDescription": "Zumi распознаёт ваши голосовые команды."
      }
    },
    "android": {
      "package": "app.zumi.assistant",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C1214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zumi слушает ваши голосовые команды и записывает встречи, чтобы сделать из них выжимку.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Zumi добавляет ваши встречи в календарь.",
          "remindersPermission": "Zumi создаёт напоминания."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Zumi импортирует контакты в вашу базу клиентов."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zumi берёт скриншоты и фото, чтобы собрать из них текст.",
          "cameraPermission": "Zumi открывает камеру по вашей голосовой команде."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6EE7A8",
          "defaultChannel": "zumi"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 6,
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 0
          },
          "androidIntentFilters": [
            "text/*",
            "audio/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "iosShareExtensionName": "Zumi"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
